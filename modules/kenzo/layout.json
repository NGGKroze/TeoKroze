{
  "title": "KENZO – опаковъчни листове и етикети",
  "subtitle": "PDF на поръчка или Excel опаковъчен лист → PL, DN и етикети по референция",
  "hide": [
    "body > header",
    "main > section.panel:nth-of-type(2) > h2"
  ],
  "side": [
    {
      "title": "1. Файлове",
      "move": [
        ".source-grid",
        "#status",
        "#progressWrap"
      ]
    },
    {
      "title": "2. Настройки",
      "move": [
        "main > section.panel:nth-of-type(2) > .hint",
        "main > section.panel:nth-of-type(2) > .grid",
        "main > section.panel:nth-of-type(2) > .warnline"
      ]
    }
  ],
  "actions": [
    {
      "sel": "#rebuildBtn",
      "kind": "secondary",
      "side": "left"
    },
    {
      "sel": "#xlsxBtn",
      "kind": "primary",
      "side": "right"
    }
  ]
}
