<UserControl
    x:Class="LogisticsPacking.App.Views.ModuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Лента с инструменти -->
        <Grid Grid.Row="0" Background="{StaticResource BarBrush}" Padding="14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OnBack" Padding="14,7">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Всички клиенти" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource StoneTextBrush}" />
                <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource StoneSoftTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="InfoButton" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                        <TextBlock Text="Нужни файлове" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="InfoFlyout" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
                <Button Click="OnReload" Padding="12,7" ToolTipService.ToolTip="Презареди клиента (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Презареди" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenResults" Padding="12,7" ToolTipService.ToolTip="Папката със свалените файлове">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="Резултати" />
                    </StackPanel>
                </Button>
                <Button Click="OnClose" Padding="12,7" ToolTipService.ToolTip="Затвори клиента и освободи паметта">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="Затвори" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="White">
            <WebView2 x:Name="Web" />

            <Grid x:Name="LoadingPanel" Background="#F5F2EC">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="True" Width="56" Height="56" />
                    <TextBlock x:Name="LoadingText" Text="Зарежда се…" FontSize="16" Foreground="{StaticResource InkSoftBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Background="#F5F2EC" Padding="40"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Spacing="14">
                <TextBlock Text="Клиентът не може да се зареди" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="ErrorText" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource InkSoftBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Опитай отново" Click="OnReload" />
                    <Button x:Name="OpenLogButton" Content="Отвори лога" Click="OnOpenLog" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <InfoBar x:Name="DownloadBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                     MaxWidth="760" IsOpen="False" Severity="Success" Title="Файлът е записан">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <HyperlinkButton Content="Отвори файла" Click="OnOpenDownloadedFile" />
                        <HyperlinkButton Content="Покажи в папка" Click="OnShowDownloadedFile" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </Grid>
    </Grid>
</UserControl>
