<UserControl
    x:Class="LogisticsPacking.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LogisticsPacking.App.Controls">

    <Grid Padding="28,18,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="BackButton" Visibility="Collapsed" Click="OnBack" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Назад" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TitleText" Text="Изберете клиент" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="CountText" FontSize="13" Foreground="{StaticResource InkSoftBrush}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" Width="440">
                <TextBox x:Name="SearchBox" PlaceholderText="Търси клиент" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown"
                         CornerRadius="8" Padding="42,11,14,11" FontSize="16" />
                <FontIcon Glyph="&#xE721;" FontSize="16" Margin="15,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Opacity="0.6" IsHitTestVisible="False" />
            </Grid>

            <Button x:Name="SettingsButton" Grid.Column="2" HorizontalAlignment="Right" Padding="12,8" Click="OnSettings"
                    ToolTipService.ToolTip="Настройки">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="Настройки" />
                </StackPanel>
            </Button>
        </Grid>

        <controls:FitGridPanel x:Name="TileGrid" Grid.Row="1" Spacing="16" />

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Няма клиент, който съвпада с търсенето."
                   FontSize="18" Foreground="{StaticResource InkSoftBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</UserControl>
