<Window
    x:Class="LogisticsPacking.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LogisticsPacking.App.Views"
    Title="Logistics Packing Solution">

    <Grid x:Name="RootGrid" Background="{StaticResource MarbleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заглавна лента: името на програмата (като в скицата) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#E61F2023">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/app.png" Width="22" Height="22" />
                <TextBlock Text="Logistics Packing Solution" Foreground="{StaticResource StoneTextBrush}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <views:HomeView x:Name="Home" />
            <Grid x:Name="ModuleHost" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
