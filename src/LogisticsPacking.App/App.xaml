<Application
    x:Class="LogisticsPacking.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Палитра: мрамор (фон), гранит (плочки), месингов акцент -->
            <ImageBrush x:Key="MarbleBrush" ImageSource="ms-appx:///Assets/marble.jpg" Stretch="UniformToFill" />
            <ImageBrush x:Key="GraniteBrush" ImageSource="ms-appx:///Assets/granite.jpg" Stretch="UniformToFill" />
            <SolidColorBrush x:Key="InkBrush" Color="#26272B" />
            <SolidColorBrush x:Key="InkSoftBrush" Color="#5B5C62" />
            <SolidColorBrush x:Key="StoneTextBrush" Color="#F4F1EA" />
            <SolidColorBrush x:Key="StoneSoftTextBrush" Color="#C9C5BC" />
            <SolidColorBrush x:Key="BrassBrush" Color="#B08D57" />
            <SolidColorBrush x:Key="TileBorderBrush" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="BarBrush" Color="#F01F2023" />

            <!-- Голяма гранитна плочка за клиент -->
            <Style x:Key="TileButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="TileRoot" CornerRadius="14" BorderThickness="1.5"
                                  BorderBrush="{StaticResource TileBorderBrush}"
                                  Background="{StaticResource GraniteBrush}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="TileShine" Background="#18FFFFFF" CornerRadius="14" Opacity="0" />
                                <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TileShine.Opacity" Value="1" />
                                                <Setter Target="TileRoot.BorderBrush" Value="{StaticResource BrassBrush}" />
                                                <Setter Target="TileScale.ScaleX" Value="1.02" />
                                                <Setter Target="TileScale.ScaleY" Value="1.02" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="TileShine.Opacity" Value="1" />
                                                <Setter Target="TileRoot.BorderBrush" Value="{StaticResource BrassBrush}" />
                                                <Setter Target="TileScale.ScaleX" Value="0.98" />
                                                <Setter Target="TileScale.ScaleY" Value="0.98" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
